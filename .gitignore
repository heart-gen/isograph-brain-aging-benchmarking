# Raw source copies are local-only and must never be tracked.
inputs/raw/
inputs/_m/*.log
07_rbp_regulation/_m/neuronal_clip/

# Derived TIN caches (regenerable from the TIN extraction step; ~283 MB).
inputs/tin/

# Generated and scratch outputs.
logs/
scratch/
tmp/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Large/intermediate model outputs not selected for release.
**/_m/tmp/
**/_m/logs/*
!**/_m/logs/
!**/_m/logs/.gitkeep
**/_o/
01_synthetic_benchmark/01_synthetic/_m/datasets/

# Heavy regenerable artifacts -> distributed via Zenodo, not git/LFS (see zenodo/).
**/feature_scores.parquet
**/feature_reconstruction.parquet
**/high_vs_low_table.parquet
**/edges.parquet

# satuRn raw input matrices (counts/coldata/txinfo, ~300 MB; regenerable from the
# quant pipeline). Only the isa_concordance result tables are tracked.
06_switch_mechanism/_m/isa_concordance/**/_saturn_inputs/

# Coloc/S-LDSC per-locus LD, SuSiE, and munge intermediates (235 GB / 1.5 GB;
# regenerable from 05_genetic_anchoring/_h). Only the lean top-level summaries
# and result tables are tracked; the per-trait subdirs are Zenodo-bound.
05_genetic_anchoring/_m/coloc/*/
05_genetic_anchoring/_m/ldsc/*/

# Downloaded motif archive (extracted ATtRACT_db.txt/pwm.txt are tracked).
inputs/rbp_motifs/*.zip

# Zenodo staging area (only the manifest + README are tracked).
zenodo/*
!zenodo/README.md
!zenodo/MANIFEST.tsv
!zenodo/.zenodo.json

# Local scratch / troubleshooting (not part of the published pipeline).
develop/

# Local settings.
.env
settings.local.*
**/_m/_shards/

# Controlled-access genotype intermediates (TOPMed/LIBD); regenerated by 08_integration/_h/01b.scz_age_projection.sh.
08_integration/_m/scz_age_projection/genotypes/
08_integration/_m/scz_age_projection/*.log

# GTEx within-gene junction usage: large, regenerable from the raw STAR junctions GCT via
# `inputs/_h/build_gtex_junction_usage.sh`. Other gtex_v11 processed parquets stay tracked.
inputs/processed/gtex_v11/*/junction_usage.parquet

# GTEx composition: intermediate genes×samples bulk-count parquets exported for the R MuSiC
# deconvolution (regenerable via `celltype_composition export-gtex`; ~85MB). The MuSiC
# outputs (proportions tsv, marker stats, fractions) are kept.
02_module_discovery/gtex/_m/composition/inputs/

# Synthetic datasets generated for the residualization-cost ablation (100 hashed dataset
# dirs, ~82 MB). Same class as 01_synthetic_benchmark/01_synthetic/_m/datasets/ above: regenerable from
# configs/residual_cost_ablation.yaml, and subject to the archived-not-regenerable rule --
# never regenerate these to "fix" a result.
01_synthetic_benchmark/01_synthetic/_m/datasets_residual_cost/

# Sharded backfill intermediates from isograph_benchmark/benchmark/backfill_metrics.py (same class as the
# already-ignored **/_m/_shards/; the merged metrics land in synthetic_results).
01_synthetic_benchmark/01_synthetic/_m/partition_backfill/

# Per-shard intermediates of the sample-table refresh. sample_table_refresh.parquet is
# their exact union (2,290 rows, identical schema) and is the tracked artifact.
01_synthetic_benchmark/01_synthetic/_m/sample_table_refresh__shard*.parquet

# Superseded raw flat-background motif count table (15 MB). The GC-binned background
# replaced it; what the flat-vs-GC comparison is actually made on are the derived
# *_flatbg call/regulon/binding tables, which ARE tracked. Its mature counterpart was not
# preserved at all (the previous rbp_counts.parquet in history is that table), so tracking
# only the intronic one would be an inconsistent half-measure. Regenerable by re-running
# rbp_scan_intronic.py with the flat background.
07_rbp_regulation/_m/rbp/rbp_counts_intronic_flatbg.parquet
reports/markdowns/
reports/pi/

# Per-tissue coloc.abf shards from the 13-task SLURM array, across all four gene-pool
# arms (166 MB). Each arm's committed `cells.parquet` is the merge of its own shards,
# so nothing downstream reads these. Regenerable with
# `sbatch 05_genetic_anchoring/_h/05a.coloc_modality_abf.sh` (+ COLOC_MODALITY_ARM).
05_genetic_anchoring/_m/coloc_modality_contrast/**/abf/

# Split-half gene-gene graphs cached for the Leiden resolution sweep (04_module_trust/_h/02a).
# Regenerable from 01a.stability_isograph.sh --save-edges; ~4 MB x seeds x halves x regions.
04_module_trust/_m/stability/edges/

# Per-half satuRn runs for the module-context held-out DTU test (04_module_trust/_h/02e).
# Regenerable in minutes; the committed outputs are the per-region replicate/null tables.
04_module_trust/_m/dtu_added_value/halves/

# Signal-level colocalization (coloc.susie). The per-locus GWAS SuSiE fits and the
# per-(analysis, tissue) result shards are heavy and fully regenerable by
# `sbatch 05_genetic_anchoring/_h/03c.coloc_gwas_susie.sh` then `06b.coloc_signal_susie.sh`.
# Only the assembled tables (signal_pairs / cells* / genes / contrast) and the report are
# tracked -- the same split the coloc.abf layer above uses for its `abf/` shards.
05_genetic_anchoring/_m/coloc_signal_susie/gwas_susie/
05_genetic_anchoring/_m/coloc_signal_susie/susie/
# The same caches under the all-introns arm, the non-switch arms and the SNP-guard
# sensitivity roots (sensitivity/max_snps_<N>/...), which mirror the primary layout.
05_genetic_anchoring/_m/coloc_signal_susie/**/gwas_susie/
05_genetic_anchoring/_m/coloc_signal_susie/**/susie/

# SMR + HEIDI (05_genetic_anchoring/_h/10a). The per-(tissue, chr) BESD (~1 GB), the per-analysis .ma GWAS files and
# the per-run SMR outputs and logs are regenerable by `--stage prep` plus the array. Only the
# targets, work list, smr_results / smr_runs and SMR_HEIDI.md are tracked.
05_genetic_anchoring/_m/smr_heidi/**/besd/
05_genetic_anchoring/_m/smr_heidi/**/gwas/
05_genetic_anchoring/_m/smr_heidi/**/smr/

# BrainSEQ coloc (05_genetic_anchoring/_h/07c). The per-(analysis, region) susie / abf / fits shards and any chr
# smoke run are regenerable from the array; prep inputs (targets, phenotypes, regions, donor
# lists) and the meta tables and BRAINSEQ_COLOC.md are tracked.
05_genetic_anchoring/_m/coloc_brainseq/*/susie/
05_genetic_anchoring/_m/coloc_brainseq/*/abf/
05_genetic_anchoring/_m/coloc_brainseq/*/fits/
05_genetic_anchoring/_m/coloc_brainseq/*/smoke/

# BrainSEQ switch-QTL. The phenotype BEDs are per-donor expression matrices (~140 MB per
# region) and the nominal cis all-pairs output runs to GBs; both are regenerated by
# `sbatch 05_genetic_anchoring/_h/01i.brainseq_switch_qtl.sh`. The permutation summaries,
# the covariate and sample tables and the genotype-panel reconciliation stay tracked.
05_genetic_anchoring/_m/brainseq_switch_qtl/**/phenotypes_*.bed.gz
05_genetic_anchoring/_m/brainseq_switch_qtl/**/qtl/*.cis_qtl_pairs.*.parquet

# phASER screen scratch: the coarse bucket key list is a run-local intermediate of the
# single-pass stream over the multi-GB allelic-count file, regenerated every run.
06_switch_mechanism/_m/ase_switch_direction/**/_buckets.txt

# Allele-aware junction recount (Quest): per-BAM count shards and bcftools scratch. The
# pooled junction_allelic_counts.parquet is the tracked product.
06_switch_mechanism/_m/ase_junction_switch/**/counts/
06_switch_mechanism/_m/ase_junction_switch/**/_lead_*
06_switch_mechanism/_m/ase_junction_switch/**/_donors.txt

# BrainSEQ swQTL/eQTL nominal cis output (18 GB of tensorQTL cis_qtl_pairs shards, plus
# the two phenotype BEDs per region) and the per-locus GWAS SuSiE cache (348 MB of RDS).
# Same class as 05_genetic_anchoring/_m/coloc/*/ above: regenerable from 05_genetic_anchoring/_h/03c + 06b and
# 05_genetic_anchoring/_h/01i, Zenodo-bound. The lean permutation results, paired contrasts, phenotype
# summaries and reports stay tracked.
05_genetic_anchoring/_m/brainseq_switch_qtl/*/*/qtl/*cis_qtl_pairs*.parquet
05_genetic_anchoring/_m/brainseq_switch_qtl/*/*/phenotypes_*.bed.gz*
05_genetic_anchoring/_m/coloc_signal_susie/gwas_susie/
